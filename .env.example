# Copy to .env and fill in. NEVER commit a real .env. No real values here.

# --- Rust API ---
API_PORT=8080
# CORS (Wave 20): the browser origins allowed to call the API,
# comma-separated exact origins (scheme + host + port). When
# unset or empty, only the local Next.js dev origin
# (http://localhost:3000) is allowed. A real deployment MUST set
# this to its deployed web origin, e.g.
# CORS_ORIGINS=https://marketplace.example.com — preflight
# answers name exactly the listed origins, never a wildcard.
CORS_ORIGINS=
# Wave 2: when set, the API connects on startup and runs the migrations
# in migrations/ automatically. When unset, the API still starts and the
# stateless Wave 1 endpoints work; DB endpoints return 503.
DATABASE_URL=postgres://marketplace:marketplace_dev_only@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379

# --- Auth (Wave 2: phone + OTP + JWT) ---
# REQUIRED for any real deployment. If unset, the API falls back to a
# well-known DEV-ONLY secret and logs a loud warning — tokens signed with
# it can be forged by anyone.
JWT_SECRET=
# Dev mode: APP_ENV=dev (or SMS_DEV_MODE=true) enables the log SMS sender
# and includes a dev_otp field in the request-otp response for local
# testing. NEVER enable in production: OTP codes would be public.
APP_ENV=dev
SMS_DEV_MODE=true

# --- Marketplace (Wave 3) ---
# Platform commission in basis points (800 = 8%), read once at API
# startup and passed to the domain build_order_totals function at
# checkout. Invalid values fall back to 800 with a warning.
# Wave 10: an admin can override this at runtime from the admin
# settings page (a platform_settings row) — the stored value wins
# over this variable for new checkouts; this stays the fallback.
COMMISSION_RATE_BPS=800

# COD advance (Wave 17): the partial prepayment a COD order must
# collect online before it ships. ADVANCE_PERCENT_BPS is the share
# of the grand total (2000 = 20%); ADVANCE_THRESHOLD_POISHA is the
# grand-total threshold at/above which an advance is required
# (200000 = 2,000 taka; 0 disables threshold-based advances —
# risk-forced advances for repeat-return buyers still apply).
# Invalid values fall back to the defaults with a warning. An
# admin can override both at runtime from the admin settings page
# (platform_settings rows) — the stored values win over these.
ADVANCE_PERCENT_BPS=2000
ADVANCE_THRESHOLD_POISHA=200000

# Sponsored promotions (Wave 26): the per-day price a seller
# pays — from their earnings balance only — to sponsor one
# product (10000 = 100 taka/day). Read once at API startup;
# invalid values fall back to 10000 with a warning. An admin
# can override this at runtime from the admin settings page
# (a platform_settings row) — the stored value wins over this
# variable for NEW promotions; bought ones keep their price.
PROMOTION_PRICE_PER_DAY_POISHA=10000

# --- Next.js web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Object storage (product images, S3-compatible / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=product-images
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- SMS gateway for phone + OTP login ---
# Wave 2 has no real gateway yet: outside dev mode (above), request-otp
# returns a typed 503 instead of pretending an SMS was sent. A real
# Bangladeshi gateway will fill these in a later wave.
SMS_API_KEY=
SMS_SENDER_ID=

# --- Courier merchant credentials (platform master accounts, Wave 3+) ---
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Optional override of Steadfast's production API base URL
# (https://portal.packzy.com/api/v1) — for sandbox/testing only.
STEADFAST_BASE_URL=
# Courier sellers get when they do not pick one (Wave 6).
DEFAULT_COURIER=steadfast
# Pathao (Wave 7): all three are required before Pathao reports
# "live" — the adapter exchanges client id + secret for a bearer
# token, and every order names the numeric store id.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_STORE_ID=
# Optional override of Pathao's production API base URL
# (https://api-hermes.pathao.com) — for sandbox/testing only.
PATHAO_BASE_URL=
# RedX (Wave 7): the single API access token. Bookings ALSO need
# the recipient's numeric RedX area_id, supplied per booking (API
# body), never via the environment.
REDX_API_KEY=
# Optional override of RedX's production API base URL
# (https://openapi.redx.com.bd/v1) — for sandbox/testing only.
REDX_BASE_URL=
# eCourier (Wave 11): BOTH the API auth token and the merchant user
# id are required before eCourier reports "live" — the adapter sends
# them as the API-AUTH-TOKEN and USER-ID headers (the exact header
# names are a merchant-onboarding confirm item; see README Wave 11).
# Bookings ALSO need the recipient's numeric eCourier area_id,
# supplied per booking (API body), never via the environment.
ECOURIER_API_KEY=
ECOURIER_USER_ID=
# Optional override of eCourier's production API base URL
# (https://backoffice.ecourier.com.bd/api) — for sandbox/testing only.
ECOURIER_BASE_URL=
# Paperfly (Wave 11): username + password (HTTP Basic) AND the
# merchant key (sent in the "paperflykey" header — the exact header
# name is a merchant-onboarding confirm item; see README Wave 11)
# are all required before Paperfly reports "live".
PAPERFLY_USERNAME=
PAPERFLY_PASSWORD=
PAPERFLY_KEY=
# Paperfly also requires the platform's pickup point on every order
# placement (a master account collects from one place). Bookings
# fail loudly, naming what is missing, until all three are set.
PAPERFLY_PICKUP_NAME=
PAPERFLY_PICKUP_PHONE=
PAPERFLY_PICKUP_ADDRESS=
# Optional override of Paperfly's production API base URL
# (https://api.paperfly.com.bd) — for sandbox/testing only.
PAPERFLY_BASE_URL=

# --- Payment merchant credentials (Wave 5) ---
# A gateway method becomes available at checkout only when ALL of its
# variables below are set (and even then, live gateway calls are not
# implemented yet — the adapters report that honestly until merchant
# accounts exist). Never commit real values.
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_API_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SHURJOPAY_USERNAME=
SHURJOPAY_PASSWORD=

# --- Payments DEV simulator (Wave 5, LOCAL/CI ONLY) ---
# PAYMENTS_DEV_MODE=true enables the DEV gateway simulator: online
# methods become available without credentials, checkout mints
# DEV-<method>-<order_id> references, and the API exposes a
# dev-simulate-success helper. Simulated payments are NOT real money.
# NEVER enable in production.
PAYMENTS_DEV_MODE=false
# HMAC secret for DEV callback signatures. When dev mode is on and
# this is unset, the API falls back to the public value "dev-secret"
# and logs a loud warning.
PAYMENTS_DEV_SECRET=

# --- Courier DEV simulator (Wave 6, LOCAL/CI ONLY) ---
# COURIER_DEV_MODE=true enables the DEV courier simulator: every
# known courier becomes bookable without credentials, bookings mint
# DEV-<courier>-<sub_order_id> consignment ids, and each tracking
# poll advances the parcel one step (picked_up, in_transit,
# out_for_delivery, delivered). Simulated shipments are NOT real
# bookings. NEVER enable in production.
COURIER_DEV_MODE=false

# --- Facebook / Meta (Wave 12) ---
# The platform's Meta app credentials. Only their PRESENCE is read:
# with both set, the seller Facebook status reports
# graph_api="configured" (the values are never stored in the
# database or returned by any endpoint). Fetching Page posts
# additionally needs the page-token OAuth flow, which lands in a
# later wave — until then sellers import by pasting post texts,
# and POST /v1/seller/products/import-from-page answers 503
# (unconfigured) or 501 (OAuth still missing), never fake posts.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- SIDRA bridge (Wave 13) -----------------------------------------
# SIDRA is the EXTERNAL AI salesperson service; the platform only
# holds this bridge. Configured only when BOTH are set: the API
# POSTs a signed notification to SIDRA_API_URL whenever a buyer
# writes, and SIDRA answers through POST /v1/sidra/reply signed
# with the same secret. Without both, the callback answers 503 and
# the inbox works as a plain human chat. The secret is never
# stored in the database and never returned by any endpoint.
SIDRA_API_URL=
SIDRA_WEBHOOK_SECRET=
