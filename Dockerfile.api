# BD Marketplace API (Rust / axum) — Wave 20 deployment image.
#
# Multi-stage: build the release binary with the workspace
# toolchain (the same Rust 1.100 the workspace is developed and
# CI-tested with; the workspace declares edition 2021 and no
# higher MSRV), then ship just the binary on a slim Debian
# runtime.
#
# Migrations need NO runtime copy: the API embeds them at
# COMPILE time via sqlx::migrate! (crates/api/src/lib.rs,
# `run_migrations`) and applies them against DATABASE_URL on
# startup. They are copied into the builder only so the macro
# can read them.

FROM rust:1.100-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations
RUN cargo build --release -p api

FROM debian:bookworm-slim AS runtime
# ca-certificates: the API makes outbound HTTPS calls (courier
# and gateway adapters, the SIDRA bridge) over rustls, which
# reads the system trust store.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10001 appuser
COPY --from=builder /app/target/release/api /usr/local/bin/bd-marketplace-api
USER appuser
# API_PORT is read by the binary at startup (default 8080).
ENV API_PORT=8080
EXPOSE 8080
CMD ["bd-marketplace-api"]
